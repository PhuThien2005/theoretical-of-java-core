      "text_snippet": "Các Câu Hỏi Ôn Tập Thường Gặp"
    },
    {
      "paragraph_id": 156,
      "start": 846.5,
      "end": 851.75,
      "duration": 5.25,
      "text_snippet": "Những khái niệm nào ở đây là các quy tắc tại thời điểm biên dịch?"
    },
    {
      "paragraph_id": 157,
      "start": 851.75,
      "end": 857.0,
      "duration": 5.25,
      "text_snippet": "Những khái niệm nào ở đây ảnh hưởng đến hành vi tại thời điểm chạy?"
    },
    {
      "paragraph_id": 158,
      "start": 857.0,
      "end": 861.55,
      "duration": 4.55,
      "text_snippet": "Những khái niệm nào ở đây dễ trở thành bẫy khi phỏng vấn?"
