      "end": 825.54,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 153,
      "start": 825.54,
      "end": 836.45,
      "duration": 10.91,
      "text_snippet": "4. Nhầm lẫn các phương thức mặc định/tĩnh với các phương thức trừu tượng"
    },
    {
      "paragraph_id": 154,
      "start": 836.45,
      "end": 844.06,
      "duration": 7.61,
      "text_snippet": "Các phương thức mặc định (default) và phương thức tĩnh (static) không phải là ph"
    },
    {
      "paragraph_id": 155,
      "start": 844.06,
      "end": 846.5,
