      "start": 525.86,
      "end": 528.61,
      "duration": 2.75,
      "text_snippet": "Giải thích Chi tiết và Ví dụ Code"
    },
    {
      "paragraph_id": 99,
      "start": 528.61,
      "end": 530.99,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 100,
      "start": 530.99,
      "end": 533.44,
      "duration": 2.45,
      "text_snippet": "Các Biến thể Kiểu Nguyên thủy"
    },
    {
      "paragraph_id": 101,
      "start": 533.54,
      "end": 537.83,
      "duration": 4.29,
      "text_snippet": "IntBinaryOperator: int applyAsInt(int, int)"
    },
    {
      "paragraph_id": 102,
      "start": 537.77,
      "end": 542.47,
      "duration": 4.7,
      "text_snippet": "LongBinaryOperator: long applyAsLong(long, long)"
    },
    {
      "paragraph_id": 103,
      "start": 542.48,
      "end": 547.89,
      "duration": 5.41,
      "text_snippet": "DoubleBinaryOperator: double applyAsDouble(double, double)"
    },
    {
      "paragraph_id": 104,
      "start": 547.89,
      "end": 550.27,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 105,
      "start": 550.26,
      "end": 553.21,
      "duration": 2.95,
      "text_snippet": "BiPredicate<T, U>"
    },
    {
      "paragraph_id": 106,
      "start": 553.21,
      "end": 560.91,
      "duration": 7.7,
      "text_snippet": "BiPredicate<T, U> nhận vào hai đối số thuộc các kiểu T và U, sau đó trả về một g"
    },
    {
      "paragraph_id": 107,
      "start": 560.91,
      "end": 564.06,
      "duration": 3.15,
      "text_snippet": "Phương thức Chức năng: boolean test(T t, U u)"
    },
    {
      "paragraph_id": 108,
      "start": 564.06,
      "end": 570.01,
      "duration": 5.95,
      "text_snippet": "Trường hợp Sử dụng Phổ biến: Kiểm tra mối quan hệ giữa hai đối tượng khác nhau."
    },
    {
      "paragraph_id": 109,
      "start": 570.01,
      "end": 572.81,
      "duration": 2.8,
      "text_snippet": "Giải thích Chi tiết và Ví dụ Code"
    },
    {
      "paragraph_id": 110,
      "start": 572.81,
      "end": 574.21,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 111,
      "start": 574.31,
      "end": 586.55,
      "duration": 12.24,
      "text_snippet": "BiFunction<T, U, R>"
    },
    {
      "paragraph_id": 112,
      "start": 586.55,
      "end": 594.6,
      "duration": 8.05,
      "text_snippet": "BiFunction<T, U, R> nhận vào hai đối số thuộc các kiểu T và U, sau đó tạo ra một"
    },
    {
      "paragraph_id": 113,
      "start": 586.55,
      "end": 591.38,
      "duration": 4.83,
      "text_snippet": "Phương thức Chức năng: R apply(T t, U u)"
    },
    {
      "paragraph_id": 114,
      "start": 591.38,
      "end": 596.56,
      "duration": 5.18,
      "text_snippet": "Trường hợp Sử dụng Phổ biến: Kết hợp hai đầu vào riêng biệt thành một biểu diễn "
    },
    {
      "paragraph_id": 115,
      "start": 596.55,
      "end": 599.3,
      "duration": 2.75,
      "text_snippet": "Giải thích Chi tiết và Ví dụ Code"
    },
    {
      "paragraph_id": 116,
      "start": 599.3,
      "end": 600.7,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 117,
      "start": 600.7,
      "end": 601.4,
      "duration": 0.7,
      "text_snippet": "BiConsumer<T, U>"
    },
    {
      "paragraph_id": 118,
      "start": 601.4,
      "end": 608.4,
      "duration": 7.0,
      "text_snippet": "BiConsumer<T, U> nhận vào hai đối số thuộc các kiểu T và U và không trả về kết q"
    },
    {
      "paragraph_id": 119,
      "start": 608.4,
      "end": 611.55,
      "duration": 3.15,
      "text_snippet": "Phương thức Chức năng: void accept(T t, U u)"
    },
    {
      "paragraph_id": 120,
      "start": 611.55,
      "end": 618.2,
      "duration": 6.65,
      "text_snippet": "Trường hợp Sử dụng Phổ biến: Duyệt qua các phần tử của một Map bằng cách sử dụng"
    },
    {
      "paragraph_id": 121,
      "start": 618.3,
      "end": 621.05,
      "duration": 2.75,
      "text_snippet": "Giải thích Chi tiết và Ví dụ Code"
    },
    {
      "paragraph_id": 122,
      "start": 621.0,
      "end": 623.38,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 123,
      "start": 623.37,
      "end": 629.72,
      "duration": 6.35,
      "text_snippet": "Đầu vào là gì? (What is the input?)"
    },
    {
      "paragraph_id": 124,
      "start": 629.72,
      "end": 633.46,
      "duration": 3.74,
      "text_snippet": "Đầu vào là gì? là một câu hỏi cốt lõi để thấu hiểu Giao Diện Chức Năng."
    },
    {
      "paragraph_id": 125,
      "start": 633.46,
      "end": 636.22,
      "duration": 2.76,
      "text_snippet": "Giải thích Chi tiết và Ví dụ Code"
    },
    {
      "paragraph_id": 126,
      "start": 636.22,
      "end": 641.47,
      "duration": 5.25,
      "text_snippet": "Khi thiết kế hoặc lựa chọn một giao diện chức năng, hãy luôn phân tích:"
    },
    {
      "paragraph_id": 127,
      "start": 641.47,
      "end": 644.62,
      "duration": 3.15,
      "text_snippet": "Có bao nhiêu đầu vào? (Không, Một, hoặc Hai)"
    },
    {
      "paragraph_id": 128,
      "start": 644.62,
      "end": 652.32,
      "duration": 7.7,
      "text_snippet": "Các kiểu đầu vào là gì? (Các đối tượng kiểu chung T, U, hoặc các kiểu nguyên thủ"
    },
    {
      "paragraph_id": 129,
      "start": 652.32,
      "end": 653.02,
      "duration": 0.7,
      "text_snippet": "Ví dụ:"
    },
    {
      "paragraph_id": 130,
      "start": 653.02,
      "end": 654.77,
      "duration": 1.75,
      "text_snippet": "Supplier<T> có không đầu vào."
    },
    {
      "paragraph_id": 131,
      "start": 654.87,
      "end": 658.39,
      "duration": 3.52,
      "text_snippet": "Function<T, R> có một đầu vào."
    },
    {
      "paragraph_id": 132,
      "start": 658.35,
      "end": 662.85,
      "duration": 4.5,
      "text_snippet": "BiFunction<T, U, R> có hai đầu vào."
    },
    {
      "paragraph_id": 133,
      "start": 662.85,
      "end": 666.5,
      "duration": 3.65,
      "text_snippet": "IntConsumer có một đầu vào là kiểu nguyên thủy int."
    },
    {
      "paragraph_id": 134,
      "start": 666.5,
      "end": 671.01,
      "duration": 4.51,
      "text_snippet": "Tại sao các Triển khai Chuyên biệt cho Kiểu Nguyên thủy Ngăn ngừa Chi phí Đóng h"
    },
    {
      "paragraph_id": 135,
      "start": 671.01,
      "end": 733.4,
      "duration": 62.39,
      "text_snippet": "Các kiểu generic trong Java phải trải qua quá trình xóa kiểu, nghĩa là JVM chỉ h"
    },
    {
      "paragraph_id": 136,
      "start": 733.4,
      "end": 734.8,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 137,
      "start": 734.8,
      "end": 741.1,
      "duration": 6.3,
      "text_snippet": "Ví dụ Thực Tế: Chi phí Đóng hộp so với Các Triển khai Chuyên biệt kiểu Nguyên th"
    },
    {
      "paragraph_id": 138,
      "start": 741.1,
      "end": 742.5,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 139,
      "start": 742.5,
      "end": 744.6,
      "duration": 2.1,
      "text_snippet": "Chuỗi Nguyên nhân - Kết quả"
    },
    {
      "paragraph_id": 140,
      "start": 744.6,
      "end": 767.0,
      "duration": 22.4,
      "text_snippet": "Sử dụng tham số kiểu chung $\\rightarrow$ Trình biên dịch bắt buộc sử dụng đối số"
    },
    {
      "paragraph_id": 141,
      "start": 767.1,
      "end": 768.95,
      "duration": 1.85,
      "text_snippet": "Các lỗi thường gặp"
    },
    {
      "paragraph_id": 142,
      "start": 768.9,
      "end": 774.46,
      "duration": 5.56,
      "text_snippet": "1. Chi phí Tự động Đóng hộp / Mở hộp (Autoboxing/Unboxing)"
    },
    {
      "paragraph_id": 143,
      "start": 774.46,
      "end": 787.02,
      "duration": 12.56,
      "text_snippet": "Sử dụng các giao diện chức năng dựa trên lớp bao bọc như Function<Integer, Integ"
    },
    {
      "paragraph_id": 144,
      "start": 787.02,
      "end": 789.4,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 145,
      "start": 789.4,
      "end": 793.49,
      "duration": 4.09,
      "text_snippet": "2. Ngoại lệ NullPointerException với các Biến thể Nguyên thủy"
    },
    {
      "paragraph_id": 146,
      "start": 793.59,
      "end": 803.31,
      "duration": 9.72,
      "text_snippet": "If a lambda returns null or a wrapper referencing null to a primitive functional"
    },
    {
      "paragraph_id": 147,
      "start": 803.26,
      "end": 805.64,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 148,
      "start": 805.64,
      "end": 811.28,
      "duration": 5.64,
      "text_snippet": "Wait, the comment was in English, let's translate the comment as well:"
    },
    {
      "paragraph_id": 149,
      "start": 811.27,
      "end": 813.65,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 150,
      "start": 813.65,
      "end": 816.99,
      "duration": 3.34,
      "text_snippet": "3. Có Nhiều hơn Một Phương thức Trừu tượng"
    },
    {
      "paragraph_id": 151,
      "start": 817.09,
      "end": 823.21,
      "duration": 6.12,
      "text_snippet": "Khai báo nhiều phương thức trừu tượng trong một giao diện được chú thích bằng @F"
    },
    {
