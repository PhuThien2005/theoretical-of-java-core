      "end": 488.76,
      "duration": 14.7,
      "text_snippet": "Thực tiễn tốt nhất: Luôn ghi log ngoại lệ hoặc wrap chúng trong ngoại lệ tùy chỉ"
    },
    {
      "paragraph_id": 107,
      "start": 488.76,
      "end": 489.81,
      "duration": 1.05,
      "text_snippet": "Lỗi Thường Gặp"
    },
    {
      "paragraph_id": 108,
      "start": 489.81,
      "end": 494.01,
      "duration": 4.2,
      "text_snippet": "1. Sửa Đổi Giá Trị Return trong Khối Finally (Reference vs. Primitive)"
    },
    {
      "paragraph_id": 109,
      "start": 494.01,
      "end": 513.26,
      "duration": 19.25,
      "text_snippet": "Nếu bạn return kiểu primitive từ try, sửa đổi nó trong finally mà không có câu l"
    },
    {
      "paragraph_id": 110,
      "start": 513.26,
      "end": 514.66,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 111,
      "start": 514.66,
      "end": 518.16,
      "duration": 3.5,
      "text_snippet": "2. Không Khai Báo Tài Nguyên Trong try-with-resources Đúng Cách"
