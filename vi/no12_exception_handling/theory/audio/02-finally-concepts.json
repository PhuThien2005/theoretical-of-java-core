      "paragraph_id": 100,
      "start": 438.36,
      "end": 441.86,
      "duration": 3.5,
      "text_snippet": "Ví Dụ Thực Tế: Anti-Pattern Nuốt Ngoại Lệ (Exception Swallowing)"
