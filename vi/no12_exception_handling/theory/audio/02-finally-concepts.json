    },
    {
      "paragraph_id": 95,
      "start": 440.98,
      "end": 444.86,
      "duration": 3.88,
      "text_snippet": "Nuốt qua Exception / Return trong Khối Finally"
    },
    {
      "paragraph_id": 96,
      "start": 444.85,
      "end": 447.05,
      "duration": 2.2,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 97,
      "start": 447.15,
      "end": 457.44,
      "duration": 10.29,
      "text_snippet": "Thực tiễn tốt nhất: Luôn ghi log ngoại lệ hoặc wrap chúng trong ngoại lệ tùy chỉ"
    },
    {
      "paragraph_id": 98,
      "start": 457.39,
      "end": 459.03,
      "duration": 1.64,
      "text_snippet": "Lỗi Thường Gặp"
    },
    {
      "paragraph_id": 99,
      "start": 459.03,
      "end": 466.36,
      "duration": 7.33,
      "text_snippet": "1. Sửa Đổi Giá Trị Return trong Khối Finally (Reference vs. Primitive)"
    },
    {
      "paragraph_id": 100,
      "start": 466.35,
      "end": 482.1,
      "duration": 15.75,
      "text_snippet": "Nếu bạn return kiểu primitive từ try, sửa đổi nó trong finally mà không có câu l"
    },
    {
      "paragraph_id": 101,
      "start": 482.2,
      "end": 484.58,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 102,
      "start": 484.53,
      "end": 488.23,
      "duration": 3.7,
      "text_snippet": "2. Không Khai Báo Tài Nguyên Trong try-with-resources Đúng Cách"
    },
    {
      "paragraph_id": 103,
      "start": 488.23,
      "end": 496.83,
      "duration": 8.6,
      "text_snippet": "Một lỗi phổ biến là khai báo biến tài nguyên bên ngoài dấu ngoặc đơn của try-wit"
    },
    {
      "paragraph_id": 104,
      "start": 496.83,
      "end": 499.03,
      "duration": 2.2,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 105,
      "start": 499.13,
      "end": 502.38,
      "duration": 3.25,
      "text_snippet": "3. Quên Implement AutoCloseable"
    },
    {
      "paragraph_id": 106,
      "start": 502.33,
      "end": 512.37,
      "duration": 10.04,
      "text_snippet": "Chỉ các lớp implement java.lang.AutoCloseable mới có thể được dùng như tài nguyê"
    },
    {
      "paragraph_id": 107,
      "start": 512.36,
      "end": 514.72,
      "duration": 2.36,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 108,
      "start": 514.73,
      "end": 516.97,
      "duration": 2.24,
      "text_snippet": "Câu Hỏi Ôn Tập Thường Gặp"
    },
    {
      "paragraph_id": 109,
      "start": 517.06,
      "end": 526.65,
      "duration": 9.59,
      "text_snippet": "Khái niệm nào ở đây là quy tắc biên dịch?"
    },
    {
      "paragraph_id": 110,
      "start": 526.65,
      "end": 529.8,
      "duration": 3.15,
      "text_snippet": "Khái niệm nào ảnh hưởng đến hành vi runtime?"
    },
    {
      "paragraph_id": 111,
      "start": 529.8,
      "end": 532.95,
      "duration": 3.15,
      "text_snippet": "Khái niệm nào có thể là bẫy phỏng vấn?"
    },
    {
      "paragraph_id": 112,
      "start": 526.65,
      "end": 530.54,
      "duration": 3.89,
      "text_snippet": "Tại Sao Finally Chạy Ngay Cả Khi Try Trả Về Sớm"
    },
    {
      "paragraph_id": 113,
      "start": 530.64,
      "end": 551.83,
      "duration": 21.19,
      "text_snippet": "Sự đảm bảo của khối finally được bắt buộc bởi JVM ở cấp độ bytecode, không chỉ l"
    },
    {
      "paragraph_id": 114,
      "start": 551.83,
      "end": 574.89,
      "duration": 23.06,
      "text_snippet": "Lý do cho sự đảm bảo này là quản lý tài nguyên. Tài nguyên như file handle, kết "
    },
    {
      "paragraph_id": 115,
      "start": 574.89,
      "end": 595.14,
      "duration": 20.25,
      "text_snippet": "Khi return được đến trong khối try, JVM lưu giá trị return trong một thanh ghi, "
    },
    {
      "paragraph_id": 116,
      "start": 595.14,
      "end": 599.43,
      "duration": 4.29,
      "text_snippet": "Mô Hình Tư Duy: JVM bytecode chèn finally"
    },
    {
      "paragraph_id": 117,
      "start": 599.53,
      "end": 601.91,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 118,
      "start": 601.85,
      "end": 606.18,
      "duration": 4.33,
      "text_snippet": "Ví Dụ Code: finally với return và với ngoại lệ"
    },
    {
      "paragraph_id": 119,
      "start": 606.18,
      "end": 608.54,
      "duration": 2.36,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 120,
      "start": 608.54,
      "end": 610.79,
      "duration": 2.25,
      "text_snippet": "Chuỗi Nguyên Nhân-Kết Quả"
    },
    {
      "paragraph_id": 121,
      "start": 610.89,
      "end": 641.84,
      "duration": 30.95,
      "text_snippet": "return 42 trong try → JVM lưu giá trị return 42 → Thực thi khối finally → finall"
    },
    {
      "paragraph_id": 122,
      "start": 641.84,
      "end": 646.59,
      "duration": 4.75,
      "text_snippet": "Tại Sao Try-With-Resources Thay Thế Finally Thủ Công cho Dọn Dẹp Tài Nguyên"
    },
    {
      "paragraph_id": 123,
      "start": 646.59,
      "end": 664.26,
      "duration": 17.67,
      "text_snippet": "Trước Java 7, việc dọn dẹp tài nguyên bằng finally có một bug tinh tế: nếu khối "
    },
    {
      "paragraph_id": 124,
      "start": 664.26,
      "end": 687.52,
      "duration": 23.26,
      "text_snippet": "try-with-resources giải quyết điều này thông qua khái niệm exception suppression"
    },
    {
      "paragraph_id": 125,
      "start": 687.63,
      "end": 710.95,
      "duration": 23.32,
      "text_snippet": "Ngoài ra, try-with-resources tạo ra code đóng được đảm bảo bởi trình biên dịch. "
    },
    {
      "paragraph_id": 126,
      "start": 710.95,
      "end": 716.14,
      "duration": 5.19,
      "text_snippet": "Mô Hình Tư Duy: finally thủ công vs try-with-resources đảm bảo đóng"
    },
    {
      "paragraph_id": 127,
      "start": 716.14,
      "end": 718.52,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 128,
      "start": 718.51,
      "end": 722.8,
      "duration": 4.29,
      "text_snippet": "Ví Dụ Code: try-with-resources và suppressed exception"
    },
    {
      "paragraph_id": 129,
      "start": 722.9,
      "end": 725.28,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 130,
      "start": 725.23,
      "end": 727.48,
      "duration": 2.25,
      "text_snippet": "Chuỗi Nguyên Nhân-Kết Quả"
    },
    {
      "paragraph_id": 131,
      "start": 727.48,
      "end": 750.87,
      "duration": 23.39,
      "text_snippet": "finally thủ công với close() trong try + khối finally → Cả try body lẫn close() "
    },
    {
      "paragraph_id": 132,
      "start": 750.86,
      "end": 754.47,
      "duration": 3.61,
      "text_snippet": "Tại Sao Chuỗi Ngoại Lệ Bảo Toàn Ngữ Cảnh Gỡ Lỗi"
    },
    {
      "paragraph_id": 133,
      "start": 754.58,
      "end": 786.97,
      "duration": 32.39,
      "text_snippet": "Khi ngoại lệ cấp thấp được ném bởi một dependency (như JDBC, file I/O, hoặc HTTP"
    },
    {
      "paragraph_id": 134,
      "start": 786.96,
      "end": 810.24,
      "duration": 23.28,
      "text_snippet": "Không có chuỗi ngoại lệ, việc chuyển đổi từ cấp thấp sang cấp cao phá hủy thông "
    },
    {
      "paragraph_id": 135,
      "start": 810.24,
      "end": 824.69,
      "duration": 14.45,
      "text_snippet": "Chuỗi ngoại lệ giải quyết điều này bằng cách lưu trữ ngoại lệ gốc như nguyên nhâ"
    },
    {
      "paragraph_id": 136,
      "start": 824.69,
      "end": 828.52,
      "duration": 3.83,
      "text_snippet": "Mô Hình Tư Duy: Chuỗi nguyên nhân của chuỗi ngoại lệ"
    },
