      "text_snippet": "Nhận diện NullPointerException trong code, lệnh, tài liệu, hoặc câu hỏi phỏng vấ"
    },
    {
      "paragraph_id": 95,
      "start": 421.46,
      "end": 426.46,
      "duration": 5.0,
      "text_snippet": "Giải thích một bug, giới hạn, hoặc đánh đổi liên quan đến NullPointerException."
    },
    {
      "paragraph_id": 96,
      "start": 426.46,
      "end": 429.26,
      "duration": 2.8,
      "text_snippet": "Ví dụ nhỏ hoặc mô hình tư duy:"
    },
    {
      "paragraph_id": 97,
      "start": 429.26,
      "end": 433.46,
      "duration": 4.2,
      "text_snippet": "Được kích hoạt khi gọi phương thức trên biến trỏ đến null."
    },
    {
      "paragraph_id": 98,
      "start": 433.46,
      "end": 436.96,
      "duration": 3.5,
      "text_snippet": "Ví Dụ Code Chạy Được: Kích Hoạt và Ngăn NullPointerException"
