    {
      "paragraph_id": 95,
      "start": 779.94,
      "end": 784.97,
      "duration": 5.03,
      "text_snippet": "Bốn vị trí bị cấm của var tiết lộ chính xác cách kiểu tĩnh được bảo toàn:"
    },
    {
      "paragraph_id": 96,
      "start": 784.96,
      "end": 793.66,
      "duration": 8.7,
      "text_snippet": "Field — kiểu của field phải được khai báo tường minh để kiểu có thể nhìn thấy bở"
    },
    {
      "paragraph_id": 97,
      "start": 793.76,
      "end": 803.81,
      "duration": 10.05,
      "text_snippet": "Tham số phương thức — người gọi phải biết kiểu của tham số để biên dịch điểm gọi"
    },
    {
      "paragraph_id": 98,
      "start": 803.81,
      "end": 810.46,
      "duration": 6.65,
      "text_snippet": "Kiểu trả về phương thức — người gọi phải biết kiểu nào mong đợi từ giá trị trả v"
    },
    {
      "paragraph_id": 99,
      "start": 803.81,
      "end": 811.68,
      "duration": 7.87,
      "text_snippet": "var không có bộ khởi tạo / var x = null — trình biên dịch không có phía bên phải"
    },
