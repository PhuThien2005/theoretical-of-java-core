    {
      "paragraph_id": 5,
      "start": 11.01,
      "end": 27.02,
      "duration": 16.01,
      "text_snippet": "Lớp java.io.File đại diện cho một đường dẫn dẫn đến một tệp hoặc thư mục trên hệ"
    },
    {
      "paragraph_id": 6,
      "start": 27.02,
      "end": 29.4,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 7,
      "start": 29.4,
      "end": 35.11,
      "duration": 5.71,
      "text_snippet": "Tạo, Xóa và Kiểm tra Tồn tại (Create, Delete, and Check Existence)"
    },
    {
      "paragraph_id": 8,
      "start": 35.11,
      "end": 41.25,
      "duration": 6.14,
      "text_snippet": "Để thực sự thao tác với các tệp trên đĩa, File cung cấp các phương thức tương tá"
    },
    {
      "paragraph_id": 9,
      "start": 41.35,
      "end": 50.66,
      "duration": 9.31,
      "text_snippet": "createNewFile(): Tạo một tệp mới, trống nếu nó chưa tồn tại. Nó trả về true nếu "
    },
    {
      "paragraph_id": 10,
      "start": 50.66,
      "end": 57.91,
      "duration": 7.25,
      "text_snippet": "delete(): Xóa tệp hoặc thư mục. Lưu ý rằng các thư mục chỉ có thể bị xóa nếu chú"
    },
    {
      "paragraph_id": 11,
      "start": 57.91,
      "end": 63.31,
      "duration": 5.4,
      "text_snippet": "exists(): Trả về một giá trị boolean cho biết tệp hoặc thư mục có tồn tại hay kh"
    },
    {
      "paragraph_id": 12,
      "start": 63.31,
      "end": 67.46,
      "duration": 4.15,
      "text_snippet": "isFile() / isDirectory(): Xác thực kiểu nút trên đĩa."
    },
    {
      "paragraph_id": 13,
      "start": 67.56,
      "end": 69.94,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 14,
      "start": 69.89,
      "end": 75.23,
      "duration": 5.34,
      "text_snippet": "Tạo thư mục và Đọc siêu dữ liệu (Create Directory and Read Metadata)"
    },
    {
      "paragraph_id": 15,
      "start": 75.23,
      "end": 89.73,
      "duration": 14.5,
      "text_snippet": "mkdir(): Tạo thư mục được đặt tên bởi đường dẫn trừu tượng này. Thất bại nếu bất"
    },
    {
      "paragraph_id": 16,
      "start": 89.73,
      "end": 96.38,
      "duration": 6.65,
      "text_snippet": "mkdirs(): Tạo thư mục, bao gồm cả bất kỳ thư mục cha cần thiết nào nhưng chưa tồ"
    },
    {
      "paragraph_id": 17,
      "start": 89.83,
      "end": 123.1,
      "duration": 33.27,
      "text_snippet": "Các phương thức siêu dữ liệu (metadata): length(): Trả về kích thước tệp tính bằ"
    },
    {
      "paragraph_id": 18,
      "start": 123.1,
      "end": 129.05,
      "duration": 5.95,
      "text_snippet": "length(): Trả về kích thước tệp tính bằng byte. Trả về 0L nếu tệp không tồn tại."
    },
    {
      "paragraph_id": 19,
      "start": 129.05,
      "end": 134.3,
      "duration": 5.25,
      "text_snippet": "getName(): Trả về tên của tệp hoặc thư mục (phần cuối cùng của đường dẫn)."
    },
    {
      "paragraph_id": 20,
      "start": 134.3,
      "end": 137.1,
      "duration": 2.8,
      "text_snippet": "getAbsolutePath(): Trả về chuỗi đường dẫn tuyệt đối."
    },
    {
      "paragraph_id": 21,
      "start": 123.2,
      "end": 125.58,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 22,
      "start": 125.53,
      "end": 134.68,
      "duration": 9.15,
      "text_snippet": "InputStream & OutputStream (Byte Streams)"
    },
    {
      "paragraph_id": 23,
      "start": 134.68,
      "end": 140.47,
      "duration": 5.79,
      "text_snippet": "InputStream và OutputStream là các lớp trừu tượng đại diện cho các luồng byte tu"
    },
    {
      "paragraph_id": 24,
      "start": 140.46,
      "end": 146.36,
      "duration": 5.9,
      "text_snippet": "read(): Đọc byte tiếp theo của dữ liệu. Trả về -1 khi đạt đến cuối luồng."
    },
    {
      "paragraph_id": 25,
      "start": 146.46,
      "end": 150.35,
      "duration": 3.89,
      "text_snippet": "write(int b): Ghi byte được chỉ định vào luồng."
    },
    {
      "paragraph_id": 26,
      "start": 150.3,
      "end": 157.48,
      "duration": 7.18,
      "text_snippet": "Quan trọng: Các luồng byte phải được đóng sau khi sử dụng để giải phóng các tài "
    },
    {
      "paragraph_id": 27,
      "start": 157.48,
      "end": 160.67,
      "duration": 3.19,
      "text_snippet": "FileInputStream & FileOutputStream"
    },
    {
      "paragraph_id": 28,
      "start": 160.66,
      "end": 165.96,
      "duration": 5.3,
      "text_snippet": "Đây là các triển khai cụ thể được sử dụng để đọc và ghi các byte từ/vào một tệp "
    },
    {
      "paragraph_id": 29,
      "start": 166.06,
      "end": 168.44,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 30,
      "start": 168.39,
      "end": 183.21,
      "duration": 14.82,
      "text_snippet": "Tại sao các luồng ký tự dịch các byte và làm hỏng dữ liệu nhị phân"
    },
    {
      "paragraph_id": 31,
      "start": 183.21,
      "end": 230.46,
      "duration": 47.25,
      "text_snippet": "Các luồng ký tự (character stream) (Reader và Writer) được thiết kế để xử lý dữ "
    },
    {
      "paragraph_id": 32,
      "start": 230.46,
      "end": 233.96,
      "duration": 3.5,
      "text_snippet": "Xử lý luồng Nhị phân so với Luồng ký tự"
    },
    {
      "paragraph_id": 33,
      "start": 230.56,
      "end": 232.94,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 34,
      "start": 232.89,
      "end": 250.5,
      "duration": 17.61,
      "text_snippet": "Ví dụ mã nguồn: Làm hỏng dữ liệu nhị phân với Reader"
    },
    {
      "paragraph_id": 35,
      "start": 250.5,
      "end": 266.6,
      "duration": 16.1,
      "text_snippet": "Ví dụ sau đây minh họa cách đọc dữ liệu nhị phân tùy ý (cụ thể là byte 0xFF) bằn"
