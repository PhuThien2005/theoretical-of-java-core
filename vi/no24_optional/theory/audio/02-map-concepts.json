      "duration": 2.25,
      "text_snippet": "Chuỗi Nguyên Nhân-Kết Quả"
    },
    {
      "paragraph_id": 97,
      "start": 597.17,
      "end": 619.94,
      "duration": 22.77,
      "text_snippet": "Mô hình domain định nghĩa với trường Optional<T> → Ứng dụng khởi tạo hàng triệu "
    },
    {
      "paragraph_id": 98,
      "start": 619.95,
      "end": 621.7,
      "duration": 1.75,
      "text_snippet": "Optional Trong Kiểu Trả Về"
    },
    {
      "paragraph_id": 99,
      "start": 621.7,
      "end": 626.6,
      "duration": 4.9,
      "text_snippet": "Optional là container có thể chứa hoặc không chứa một giá trị khác null."
    },
    {
      "paragraph_id": 100,
      "start": 619.95,
      "end": 628.95,
      "duration": 9.0,
      "text_snippet": "Dùng nó để dự đoán chính xác quy tắc Java, dạng hợp lệ và chế độ thất bại. Ôn vớ"
    },
    {
      "paragraph_id": 101,
      "start": 628.95,
      "end": 630.35,
      "duration": 1.4,
      "text_snippet": "Kiểm tra thực tế:"
    },
    {
      "paragraph_id": 102,
      "start": 630.35,
      "end": 633.85,
      "duration": 3.5,
      "text_snippet": "Định nghĩa Optional trong Kiểu Trả Về trong một câu."
    },
    {
      "paragraph_id": 103,
      "start": 633.85,
      "end": 639.8,
      "duration": 5.95,
      "text_snippet": "Nhận diện Optional trong Kiểu Trả Về trong code, lệnh, tài liệu hoặc câu hỏi phỏ"
    },
    {
      "paragraph_id": 104,
      "start": 639.8,
      "end": 645.75,
      "duration": 5.95,
      "text_snippet": "Giải thích một lỗi, hạn chế hoặc đánh đổi liên quan đến Optional trong Kiểu Trả "
    },
    {
      "paragraph_id": 105,
      "start": 645.75,
      "end": 648.55,
      "duration": 2.8,
      "text_snippet": "Ví dụ nhỏ hoặc mô hình tư duy:"
    },
    {
      "paragraph_id": 106,
      "start": 648.55,
      "end": 651.35,
      "duration": 2.8,
      "text_snippet": "Optional.ofNullable(value) xử lý giá trị có thể null."
    },
    {
      "paragraph_id": 107,
      "start": 651.35,
      "end": 652.75,
      "duration": 1.4,
      "text_snippet": "Giải Thích Chi Tiết"
    },
    {
      "paragraph_id": 108,
      "start": 652.75,
      "end": 666.4,
      "duration": 13.65,
      "text_snippet": "Mục đích chính của Optional là phục vụ như kiểu trả về cho các phương thức có th"
    },
    {
      "paragraph_id": 109,
      "start": 666.4,
      "end": 680.4,
      "duration": 14.0,
      "text_snippet": "Không bao giờ trả về null từ phương thức được khai báo trả về Optional<T>. Luôn "
    },
    {
      "paragraph_id": 110,
      "start": 680.4,
      "end": 682.15,
      "duration": 1.75,
      "text_snippet": "Ví Dụ Code Chạy Được"
    },
    {
      "paragraph_id": 111,
      "start": 682.25,
      "end": 684.63,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 112,
      "start": 684.58,
      "end": 686.22,
      "duration": 1.64,
      "text_snippet": "Lỗi Thường Gặp"
    },
    {
      "paragraph_id": 113,
      "start": 686.21,
      "end": 702.25,
      "duration": 16.04,
      "text_snippet": "Trả về Optional từ getter khi tham chiếu nullable thô được kỳ vọng bởi thư viện "
    },
    {
      "paragraph_id": 114,
      "start": 702.25,
      "end": 707.35,
      "duration": 5.1,
      "text_snippet": "Ví Dụ Thực Tế: Anti-Pattern Optional vs Code Đặc Trưng"
    },
    {
      "paragraph_id": 115,
      "start": 707.35,
      "end": 715.57,
      "duration": 8.22,
      "text_snippet": "Để đảm bảo thiết kế sạch, hiệu năng và code Java tuân thủ tiêu chuẩn, lập trình "
    },
    {
      "paragraph_id": 116,
      "start": 715.58,
      "end": 717.68,
      "duration": 2.1,
      "text_snippet": "Anti-Pattern 1: Optional Làm Trường Class"
    },
    {
      "paragraph_id": 117,
      "start": 717.68,
      "end": 719.08,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 118,
      "start": 719.08,
      "end": 720.13,
      "duration": 1.05,
      "text_snippet": "Tại sao xấu:"
    },
    {
      "paragraph_id": 119,
      "start": 720.12,
      "end": 728.52,
      "duration": 8.4,
      "text_snippet": "Optional không Serializable. Nếu class này được tuần tự hóa (ví dụ: trong sessio"
    },
    {
      "paragraph_id": 120,
      "start": 728.53,
      "end": 737.63,
      "duration": 9.1,
      "text_snippet": "Mỗi instance Optional thêm 16 byte chi phí bộ nhớ trên JVM 64-bit (cộng tham chi"
    },
    {
      "paragraph_id": 121,
      "start": 737.62,
      "end": 742.87,
      "duration": 5.25,
      "text_snippet": "Giải Pháp Đặc Trưng: Giữ trường nullable và trả về Optional trong getter nếu cần"
    },
    {
      "paragraph_id": 122,
      "start": 742.88,
      "end": 744.28,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 123,
      "start": 744.27,
      "end": 747.07,
      "duration": 2.8,
      "text_snippet": "Anti-Pattern 2: Optional Làm Tham Số Phương Thức"
    },
    {
      "paragraph_id": 124,
      "start": 747.08,
      "end": 748.48,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 125,
      "start": 748.48,
      "end": 749.53,
      "duration": 1.05,
      "text_snippet": "Tại sao xấu:"
    },
    {
      "paragraph_id": 126,
      "start": 749.62,
      "end": 771.43,
      "duration": 21.81,
      "text_snippet": "Buộc người gọi phải bọc tham số (ví dụ: updateAddress(1, Optional.of(\"Main St\"))"
    },
    {
      "paragraph_id": 127,
      "start": 771.44,
      "end": 779.14,
      "duration": 7.7,
      "text_snippet": "Người gọi có thể truyền null vào phương thức thay vì Optional.empty(), dẫn đến N"
    },
    {
      "paragraph_id": 128,
      "start": 771.44,
      "end": 776.75,
      "duration": 5.31,
      "text_snippet": "Giải Pháp Đặc Trưng: Dùng nạp chồng phương thức hoặc xử lý tham số nullable tiêu"
    },
    {
      "paragraph_id": 129,
      "start": 776.75,
      "end": 779.13,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 130,
      "start": 779.12,
      "end": 783.07,
      "duration": 3.95,
      "text_snippet": "Anti-Pattern 3: Optional Bọc Collection"
    },
    {
      "paragraph_id": 131,
      "start": 783.17,
      "end": 785.55,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 132,
      "start": 785.5,
      "end": 803.64,
      "duration": 18.14,
      "text_snippet": "Tại sao xấu: Collection (List, Set, Map) đã có cách biểu diễn sự vắng mặt tiêu c"
    },
    {
      "paragraph_id": 133,
      "start": 803.64,
      "end": 807.75,
      "duration": 4.11,
      "text_snippet": "Giải Pháp Đặc Trưng: Luôn trả về collection rỗng trực tiếp."
    },
    {
      "paragraph_id": 134,
      "start": 807.75,
      "end": 810.13,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 135,
      "start": 810.12,
      "end": 815.66,
      "duration": 5.54,
      "text_snippet": "Anti-Pattern 4: Pattern isPresent() + get() (Optional Mệnh Lệnh)"
    },
    {
      "paragraph_id": 136,
      "start": 815.66,
      "end": 817.06,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 137,
      "start": 817.06,
      "end": 830.01,
      "duration": 12.95,
      "text_snippet": "Tại sao xấu: Nó bắt chước kiểm tra null truyền thống và không đạt được lợi ích l"
    },
    {
      "paragraph_id": 138,
      "start": 830.01,
      "end": 833.51,
      "duration": 3.5,
      "text_snippet": "Giải Pháp Đặc Trưng: Dùng ifPresent, map, orElseGet, hoặc orElseThrow."
    },
    {
      "paragraph_id": 139,
      "start": 833.51,
      "end": 834.91,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
