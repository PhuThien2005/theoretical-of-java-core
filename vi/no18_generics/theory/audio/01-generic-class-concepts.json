      "paragraph_id": 30,
      "start": 183.5,
      "end": 192.1,
      "duration": 8.6,
      "text_snippet": "Định nghĩa: Một giao diện khai báo các tham số kiểu, bắt buộc các lớp triển khai"
    },
    {
      "paragraph_id": 31,
      "start": 192.1,
      "end": 194.15,
      "duration": 2.05,
      "text_snippet": "Quy tắc Java:"
    },
    {
