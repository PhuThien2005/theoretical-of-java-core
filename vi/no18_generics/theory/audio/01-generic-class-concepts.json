      "end": 179.74,
      "duration": 8.54,
      "text_snippet": "Nếu không có khai báo tham số kiểu, trình biên dịch không thể bắt buộc tính nhất"
    },
    {
      "paragraph_id": 29,
      "start": 179.84,
      "end": 183.55,
      "duration": 3.71,
      "text_snippet": "3. Giao diện tổng quát (Generic Interface)"
