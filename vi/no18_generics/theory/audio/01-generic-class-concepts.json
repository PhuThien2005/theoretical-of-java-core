      "duration": 2.55,
      "text_snippet": "Các trường hợp sử dụng hợp lệ:"
    },
    {
      "paragraph_id": 9,
      "start": 62.24,
      "end": 65.74,
      "duration": 3.5,
      "text_snippet": "Box<String>, Box<Integer> — các bộ chứa đơn kiểu (single-typed containers)."
    },
