    {
      "paragraph_id": 19,
      "start": 113.4,
      "end": 115.78,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 20,
      "start": 115.77,
      "end": 128.6,
      "duration": 12.83,
      "text_snippet": "Trình biên dịch sẽ suy luận (infer) tham số kiểu từ đối số tại nơi gọi (call-sit"
    },
    {
      "paragraph_id": 21,
      "start": 128.7,
      "end": 131.44,
      "duration": 2.74,
      "text_snippet": "Các trường hợp sử dụng hợp lệ:"
    },
    {
      "paragraph_id": 22,
      "start": 131.39,
      "end": 141.95,
      "duration": 10.56,
      "text_snippet": "Collections.max(Collection<? extends T>) — hoạt động với bất kỳ kiểu phần tử có "
    },
    {
      "paragraph_id": 23,
      "start": 141.95,
      "end": 150.08,
      "duration": 8.13,
      "text_snippet": "Arrays.asList(T... a) — chuyển đổi các tham số biến đổi (varargs) thành một danh"
    },
    {
      "paragraph_id": 24,
      "start": 150.07,
      "end": 156.89,
      "duration": 6.82,
      "text_snippet": "Các phương thức tiện ích/bổ trợ (utility/helper methods) có khả năng tái sử dụng"
    },
    {
      "paragraph_id": 25,
      "start": 157.0,
      "end": 166.11,
      "duration": 9.11,
      "text_snippet": "Xem thêm: Sự kết hợp chặt chẽ giữa Generics và Java Collections Framework, được "
    },
