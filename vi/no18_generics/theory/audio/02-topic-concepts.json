      "duration": 8.27,
      "text_snippet": "2. PECS — Producer Extends, Consumer Super (Nhà Sản Xuất Dùng Extends, Bên Tiêu "
    },
    {
      "paragraph_id": 23,
      "start": 132.81,
      "end": 152.41,
      "duration": 19.6,
      "text_snippet": "Mẹo ghi nhớ (Mnemonic): PECS — Producer Extends, Consumer Super"
    },
    {
      "paragraph_id": 24,
      "start": 152.41,
      "end": 159.76,
      "duration": 7.35,
      "text_snippet": "<? extends T> — <? extends T>: Cung cấp các quy tắc và cơ chế hoạt động cụ thể t"
    },
    {
      "paragraph_id": 25,
      "start": 159.76,
      "end": 167.11,
      "duration": 7.35,
      "text_snippet": "<? super T> — <? super T>: Cung cấp các quy tắc và cơ chế hoạt động cụ thể trong"
    },
    {
      "paragraph_id": 26,
      "start": 152.41,
      "end": 153.81,
      "duration": 1.4,
      "text_snippet": "Quy tắc quyết định:"
    },
    {
      "paragraph_id": 27,
      "start": 153.81,
      "end": 160.11,
      "duration": 6.3,
      "text_snippet": "Nếu một tham số sản xuất (bạn đọc các giá trị T từ nó) → <? extends T>."
    },
    {
      "paragraph_id": 28,
      "start": 160.11,
      "end": 166.41,
      "duration": 6.3,
      "text_snippet": "Nếu một tham số tiêu thụ (bạn ghi các giá trị T vào nó) → <? super T>."
    },
    {
      "paragraph_id": 29,
      "start": 166.41,
      "end": 173.06,
      "duration": 6.65,
      "text_snippet": "Nếu cần cả đọc và ghi → sử dụng kiểu chính xác T (không dùng ký tự đại diện)."
    },
    {
      "paragraph_id": 30,
      "start": 173.06,
      "end": 175.16,
      "duration": 2.1,
      "text_snippet": "Ví dụ thực tế trong JDK:"
