      "text_snippet": "Bạn Cần Học Gì"
    },
    {
      "paragraph_id": 3,
      "start": 4.85,
      "end": 8.88,
      "duration": 4.03,
      "text_snippet": "Sau khi hoàn thành chủ đề này, bạn sẽ có thể giải thích:"
    },
    {
      "paragraph_id": 4,
      "start": 8.88,
      "end": 12.73,
      "duration": 3.85,
      "text_snippet": "Java là gì và tại sao nó được sử dụng rộng rãi."
    },
    {
      "paragraph_id": 5,
      "start": 12.72,
      "end": 18.92,
      "duration": 6.2,
      "text_snippet": "Ý nghĩa thực sự của \"viết một lần, chạy mọi nơi\" (write once, run anywhere)."
    },
    {
      "paragraph_id": 6,
      "start": 19.03,
      "end": 24.18,
      "duration": 5.15,
      "text_snippet": "Sự khác biệt giữa JVM, JRE, và JDK."
    },
    {
      "paragraph_id": 7,
      "start": 24.12,
      "end": 28.98,
      "duration": 4.86,
      "text_snippet": "Cách mã nguồn Java trở thành bytecode và sau đó chạy trên JVM."
    },
    {
      "paragraph_id": 8,
      "start": 28.99,
      "end": 35.8,
      "duration": 6.81,
      "text_snippet": "JIT compilation (biên dịch JIT) và Garbage Collection (thu gom rác) làm gì."
    },
    {
      "paragraph_id": 9,
      "start": 35.8,
      "end": 41.14,
      "duration": 5.34,
      "text_snippet": "Sự khác biệt giữa Java SE, Jakarta EE, và Java ME."
    },
    {
      "paragraph_id": 10,
      "start": 41.14,
      "end": 46.75,
      "duration": 5.61,
      "text_snippet": "Tại sao Java 8, 11, 17, và 21 thường được nhắc đến."
    },
    {
