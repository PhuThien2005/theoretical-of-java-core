{
  "lesson": "02-jvm-jre-jdk",
  "total_duration_seconds": 328.13,
  "total_paragraphs": 50,
  "timestamps": [
    {
      "paragraph_id": 1,
      "start": 0.0,
      "end": 1.18,
      "duration": 1.18,
      "text_snippet": "JVM, JRE Và JDK"
    },
    {
      "paragraph_id": 2,
      "start": 1.18,
      "end": 15.57,
      "duration": 14.39,
      "text_snippet": "JVM, JRE, và JDK là ba thuật ngữ quan trọng nhất trong Java. Nhiều người mới học thuộc lòng tên gọi nhưng không hiểu mối"
    },
    {
      "paragraph_id": 3,
      "start": 15.57,
      "end": 16.9,
      "duration": 1.34,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 4,
      "start": 16.9,
      "end": 17.14,
      "duration": 0.24,
      "text_snippet": "JVM"
    },
    {
      "paragraph_id": 5,
      "start": 17.14,
      "end": 21.46,
      "duration": 4.32,
      "text_snippet": "JVM là viết tắt của Java Virtual Machine (Máy Ảo Java)."
    },
    {
      "paragraph_id": 6,
      "start": 21.46,
      "end": 28.93,
      "duration": 7.47,
      "text_snippet": "JVM chịu trách nhiệm thực thi bytecode Java. Nó đọc các file .class và chạy các lệnh bên trong."
    },
    {
      "paragraph_id": 7,
      "start": 28.93,
      "end": 30.03,
      "duration": 1.1,
      "text_snippet": "JVM còn xử lý:"
    },
    {
      "paragraph_id": 8,
      "start": 30.03,
      "end": 47.09,
      "duration": 17.06,
      "text_snippet": "Nạp lớp (Class loading).\nXác minh bytecode (Bytecode verification).\nCác vùng bộ nhớ runtime (Runtime memory areas).\nThu "
    },
    {
      "paragraph_id": 9,
      "start": 47.09,
      "end": 47.32,
      "duration": 0.24,
      "text_snippet": "JRE"
    },
    {
      "paragraph_id": 10,
      "start": 47.32,
      "end": 52.98,
      "duration": 5.66,
      "text_snippet": "JRE là viết tắt của Java Runtime Environment (Môi Trường Thực Thi Java)."
    },
    {
      "paragraph_id": 11,
      "start": 52.98,
      "end": 57.23,
      "duration": 4.25,
      "text_snippet": "JRE chứa những gì cần thiết để chạy chương trình Java:"
    },
    {
      "paragraph_id": 12,
      "start": 57.23,
      "end": 60.92,
      "duration": 3.69,
      "text_snippet": "Một JVM.\nCác thư viện runtime.\nCác file hỗ trợ."
    },
    {
      "paragraph_id": 13,
      "start": 60.92,
      "end": 66.27,
      "duration": 5.35,
      "text_snippet": "Nếu bạn chỉ muốn chạy một ứng dụng Java, runtime tương tự JRE là đủ."
    },
    {
      "paragraph_id": 14,
      "start": 66.27,
      "end": 66.51,
      "duration": 0.24,
      "text_snippet": "JDK"
    },
    {
      "paragraph_id": 15,
      "start": 66.51,
      "end": 72.01,
      "duration": 5.5,
      "text_snippet": "JDK là viết tắt của Java Development Kit (Bộ Công Cụ Phát Triển Java)."
    },
    {
      "paragraph_id": 16,
      "start": 72.01,
      "end": 76.73,
      "duration": 4.72,
      "text_snippet": "JDK chứa những gì cần thiết để phát triển chương trình Java:"
    },
    {
      "paragraph_id": 17,
      "start": 76.73,
      "end": 84.27,
      "duration": 7.55,
      "text_snippet": "Các thành phần JRE/runtime.\nTrình biên dịch Java javac.\nCác công cụ như jar, javadoc, và jshell."
    },
    {
      "paragraph_id": 18,
      "start": 84.27,
      "end": 88.52,
      "duration": 4.25,
      "text_snippet": "Nếu bạn muốn viết và biên dịch code Java, bạn cần JDK."
    },
    {
      "paragraph_id": 19,
      "start": 88.52,
      "end": 93.71,
      "duration": 5.19,
      "text_snippet": "Tại Sao Phát Triển Cần JDK Nhưng Môi Trường Production Chỉ Cần JRE"
    },
    {
      "paragraph_id": 20,
      "start": 93.71,
      "end": 161.71,
      "duration": 68.0,
      "text_snippet": "Phát triển phần mềm Java đòi hỏi chuyển đổi mã nguồn dễ đọc của con người thành bytecode nhị phân — một quá trình do trì"
    },
    {
      "paragraph_id": 21,
      "start": 161.71,
      "end": 164.69,
      "duration": 2.99,
      "text_snippet": "Mô Hình Tư Duy: Bếp Nhà Hàng và Bàn Ăn"
    },
    {
      "paragraph_id": 22,
      "start": 164.69,
      "end": 192.52,
      "duration": 27.83,
      "text_snippet": "Hãy nghĩ JDK như một bếp nhà hàng chuyên nghiệp, chứa đầu bếp, lò nướng, bếp gas, và sách công thức cần thiết để chuẩn b"
    },
    {
      "paragraph_id": 23,
      "start": 192.52,
      "end": 193.86,
      "duration": 1.34,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 24,
      "start": 193.86,
      "end": 196.61,
      "duration": 2.75,
      "text_snippet": "Ví Dụ Code: Hành Vi Lệnh JRE và JDK"
    },
    {
      "paragraph_id": 25,
      "start": 196.61,
      "end": 207.62,
      "duration": 11.01,
      "text_snippet": "Nếu bạn cố biên dịch file nguồn trên máy chỉ cài JRE, hệ điều hành sẽ không tìm thấy javac, trong khi chạy bytecode với "
    },
    {
      "paragraph_id": 26,
      "start": 207.62,
      "end": 208.95,
      "duration": 1.34,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 27,
      "start": 208.95,
      "end": 216.58,
      "duration": 7.63,
      "text_snippet": "Trên máy cài JDK:\n$ javac HelloWorld.java\nOutput: (Biên dịch thành công, tạo ra HelloWorld.class)"
    },
    {
      "paragraph_id": 28,
      "start": 216.58,
      "end": 222.63,
      "duration": 6.05,
      "text_snippet": "$ java HelloWorld\nOutput: Hello Java (Thực thi thành công dùng JVM runtime)\n`"
    },
    {
      "paragraph_id": 29,
      "start": 222.63,
      "end": 224.75,
      "duration": 2.12,
      "text_snippet": "Chuỗi Nguyên Nhân - Kết Quả"
    },
    {
      "paragraph_id": 30,
      "start": 224.75,
      "end": 249.2,
      "duration": 24.45,
      "text_snippet": "Lập trình viên viết mã nguồn .java $\\rightarrow$ javac của JDK biên dịch thành bytecode .class $\\rightarrow$ Server prod"
    },
    {
