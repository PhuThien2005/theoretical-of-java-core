  "timestamps": [
    {
      "paragraph_id": 1,
      "start": 0.1,
      "end": 10.24,
      "duration": 10.14,
      "text_snippet": "JVM, JRE Và JDK"
    },
    {
      "paragraph_id": 2,
      "start": 10.24,
      "end": 17.99,
      "duration": 7.75,
      "text_snippet": "JVM, JRE, và JDK là ba thuật ngữ quan trọng nhất trong Java. Nhiều người mới học"
    },
    {
      "paragraph_id": 3,
      "start": 17.99,
      "end": 20.37,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 4,
      "start": 20.36,
      "end": 27.57,
      "duration": 7.21,
      "text_snippet": "JVM"
    },
    {
      "paragraph_id": 5,
      "start": 27.58,
      "end": 31.43,
      "duration": 3.85,
      "text_snippet": "JVM là viết tắt của Java Virtual Machine (Máy Ảo Java)."
    },
    {
      "paragraph_id": 6,
      "start": 27.68,
      "end": 37.82,
      "duration": 10.14,
      "text_snippet": "JVM chịu trách nhiệm thực thi bytecode Java. Nó đọc các file .class và chạy các "
    },
    {
      "paragraph_id": 7,
      "start": 37.81,
      "end": 39.21,
      "duration": 1.4,
      "text_snippet": "JVM còn xử lý:"
    },
    {
      "paragraph_id": 8,
      "start": 37.81,
      "end": 40.53,
      "duration": 2.72,
      "text_snippet": "Nạp lớp (Class loading)."
    },
    {
      "paragraph_id": 9,
      "start": 40.54,
      "end": 44.26,
      "duration": 3.72,
      "text_snippet": "Xác minh bytecode (Bytecode verification)."
    },
    {
      "paragraph_id": 10,
      "start": 44.26,
      "end": 48.56,
      "duration": 4.3,
      "text_snippet": "Các vùng bộ nhớ runtime (Runtime memory areas)."
    },
    {
      "paragraph_id": 11,
      "start": 48.66,
      "end": 51.92,
      "duration": 3.26,
      "text_snippet": "Thu gom rác (Garbage Collection)."
    },
    {
      "paragraph_id": 12,
      "start": 51.88,
      "end": 55.88,
      "duration": 4.0,
      "text_snippet": "Biên dịch JIT (JIT compilation)."
    },
    {
      "paragraph_id": 13,
      "start": 55.88,
      "end": 59.16,
      "duration": 3.28,
      "text_snippet": "Quản lý luồng (Thread management)."
    },
    {
      "paragraph_id": 14,
      "start": 59.15,
      "end": 66.68,
      "duration": 7.53,
      "text_snippet": "JRE"
    },
    {
      "paragraph_id": 15,
      "start": 66.67,
      "end": 71.22,
      "duration": 4.55,
      "text_snippet": "JRE là viết tắt của Java Runtime Environment (Môi Trường Thực Thi Java)."
    },
    {
      "paragraph_id": 16,
      "start": 66.77,
      "end": 70.96,
      "duration": 4.19,
      "text_snippet": "JRE chứa những gì cần thiết để chạy chương trình Java:"
    },
    {
      "paragraph_id": 17,
      "start": 70.91,
      "end": 73.06,
      "duration": 2.15,
      "text_snippet": "Một JVM."
    },
    {
      "paragraph_id": 18,
      "start": 73.06,
      "end": 75.2,
      "duration": 2.14,
      "text_snippet": "Các thư viện runtime."
    },
    {
      "paragraph_id": 19,
      "start": 75.2,
      "end": 77.1,
      "duration": 1.9,
      "text_snippet": "Các file hỗ trợ."
    },
    {
      "paragraph_id": 20,
      "start": 77.1,
      "end": 82.53,
      "duration": 5.43,
      "text_snippet": "Nếu bạn chỉ muốn chạy một ứng dụng Java, runtime tương tự JRE là đủ."
    },
    {
      "paragraph_id": 21,
      "start": 82.62,
      "end": 94.38,
      "duration": 11.76,
      "text_snippet": "JDK"
    },
    {
      "paragraph_id": 22,
      "start": 94.39,
      "end": 99.29,
      "duration": 4.9,
      "text_snippet": "JDK là viết tắt của Java Development Kit (Bộ Công Cụ Phát Triển Java)."
    },
    {
      "paragraph_id": 23,
      "start": 99.29,
      "end": 103.49,
      "duration": 4.2,
      "text_snippet": "JDK chứa những gì cần thiết để phát triển chương trình Java:"
    },
    {
      "paragraph_id": 24,
      "start": 94.39,
      "end": 97.6,
      "duration": 3.21,
      "text_snippet": "Các thành phần JRE/runtime."
    },
    {
      "paragraph_id": 25,
      "start": 97.6,
      "end": 100.12,
      "duration": 2.52,
      "text_snippet": "Trình biên dịch Java javac."
