      "start": 102.09,
      "end": 104.47,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 23,
      "start": 104.46,
      "end": 107.93,
      "duration": 3.47,
      "text_snippet": "Kết quả có thể không chính xác là 0.3."
    },
    {
      "paragraph_id": 24,
      "start": 107.94,
      "end": 112.83,
      "duration": 4.89,
      "text_snippet": "Đối với tiền tệ, các lập trình viên Java thường sử dụng BigDecimal."
    },
    {
      "paragraph_id": 25,
      "start": 112.92,
      "end": 114.35,
      "duration": 1.43,
      "text_snippet": "Kiểu char"
    },
    {
      "paragraph_id": 26,
      "start": 114.3,
      "end": 118.41,
      "duration": 4.11,
      "text_snippet": "char lưu trữ một đơn vị mã UTF-16 đơn lẻ."
