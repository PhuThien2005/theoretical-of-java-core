      "end": 10.03,
      "duration": 9.93,
      "text_snippet": "Kiểu Dữ Liệu Nguyên Thủy (Primitive Types)"
    },
    {
      "paragraph_id": 2,
      "start": 10.03,
      "end": 15.58,
      "duration": 5.55,
      "text_snippet": "Kiểu dữ liệu nguyên thủy (Primitive Types) là các kiểu dữ liệu tích hợp sẵn đơn "
    },
    {
      "paragraph_id": 3,
      "start": 15.57,
      "end": 18.41,
      "duration": 2.84,
      "text_snippet": "Java có 8 kiểu nguyên thủy:"
    },
    {
      "paragraph_id": 4,
      "start": 18.41,
      "end": 22.18,
      "duration": 3.77,
      "text_snippet": "Kích Thước Trong Bộ Nhớ (Size In Memory)"
    },
    {
      "paragraph_id": 5,
      "start": 22.29,
      "end": 53.59,
      "duration": 31.3,
      "text_snippet": "Mỗi kiểu nguyên thủy đều có một kích thước cố định, được đảm bảo trong bộ nhớ. Đ"
    },
    {
      "paragraph_id": 6,
      "start": 53.59,
      "end": 71.44,
      "duration": 17.85,
      "text_snippet": "Kích thước cố định này là lý do tại sao các kiểu nguyên thủy có thể được lưu trữ"
    },
    {
      "paragraph_id": 7,
      "start": 71.44,
      "end": 73.54,
      "duration": 2.1,
      "text_snippet": "Các Kiểu Số Nguyên (Integer Types)"
    },
    {
      "paragraph_id": 8,
      "start": 73.54,
      "end": 77.04,
      "duration": 3.5,
      "text_snippet": "Các kiểu số nguyên dùng để lưu trữ số nguyên."
    },
    {
      "paragraph_id": 9,
      "start": 53.69,
      "end": 56.07,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 10,
      "start": 56.01,
      "end": 64.3,
      "duration": 8.29,
      "text_snippet": "int là kiểu mặc định cho các hằng số nguyên (integer literal)."
    },
    {
      "paragraph_id": 11,
      "start": 64.3,
      "end": 67.8,
      "duration": 3.5,
      "text_snippet": "Các hằng số long thường sử dụng hậu tố L:"
    },
    {
      "paragraph_id": 12,
      "start": 64.3,
      "end": 66.5,
      "duration": 2.2,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 13,
      "start": 66.6,
      "end": 73.95,
      "duration": 7.35,
      "text_snippet": "Hãy sử dụng chữ in hoa L, không dùng chữ thường l, vì chữ thường l rất dễ bị nhầ"
    },
    {
      "paragraph_id": 14,
      "start": 73.9,
      "end": 83.37,
      "duration": 9.47,
      "text_snippet": "Các Kiểu Số Thực Dấu Phẩy Động (Floating-Point Types)"
    },
    {
      "paragraph_id": 15,
      "start": 83.38,
      "end": 88.63,
      "duration": 5.25,
      "text_snippet": "Các kiểu số thực dấu phẩy động (floating-point) dùng để lưu trữ số thập phân."
    },
    {
      "paragraph_id": 16,
      "start": 83.38,
      "end": 85.58,
      "duration": 2.2,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 17,
      "start": 85.67,
      "end": 92.43,
      "duration": 6.76,
      "text_snippet": "double là kiểu mặc định cho các hằng số thập phân."
    },
    {
      "paragraph_id": 18,
      "start": 92.44,
      "end": 95.59,
      "duration": 3.15,
      "text_snippet": "Các hằng số float cần có hậu tố F:"
    },
    {
      "paragraph_id": 19,
      "start": 92.44,
      "end": 94.82,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 20,
      "start": 94.81,
      "end": 100.43,
      "duration": 5.62,
      "text_snippet": "Số thực dấu phẩy động không lý tưởng để biểu diễn tiền tệ vì chúng có thể gặp sa"
    },
    {
      "paragraph_id": 21,
      "start": 100.54,
      "end": 102.14,
      "duration": 1.6,
      "text_snippet": "Ví dụ:"
    },
    {
