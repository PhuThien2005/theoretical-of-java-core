      "start": 135.38,
      "end": 136.78,
      "duration": 1.4,
      "text_snippet": "boolean chỉ lưu trữ:"
    },
    {
      "paragraph_id": 33,
      "start": 135.47,
      "end": 137.85,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
