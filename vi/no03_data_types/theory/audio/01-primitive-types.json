    {
      "paragraph_id": 50,
      "start": 191.55,
      "end": 211.67,
      "duration": 20.12,
      "text_snippet": "Các phép toán số nguyên trong Java sẽ tự động quay vòng (wrap around) một cách â"
    },
    {
      "paragraph_id": 51,
      "start": 211.68,
      "end": 214.13,
      "duration": 2.45,
      "text_snippet": "Phạm vi của int: −2,147,483,648 đến 2,147,483,647."
    },
    {
