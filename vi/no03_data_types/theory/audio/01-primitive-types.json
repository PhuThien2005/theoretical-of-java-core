      "start": 118.41,
      "end": 120.79,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 28,
      "start": 120.79,
      "end": 126.47,
      "duration": 5.68,
      "text_snippet": "Dấu nháy đơn được sử dụng cho char. Dấu nháy kép được sử dụng cho String."
    },
    {
      "paragraph_id": 29,
      "start": 126.56,
      "end": 128.94,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 30,
      "start": 128.89,
      "end": 131.5,
      "duration": 2.61,
      "text_snippet": "Chúng không phải là cùng một kiểu."
    },
    {
      "paragraph_id": 31,
      "start": 131.5,
