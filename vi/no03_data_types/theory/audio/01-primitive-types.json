    {
      "paragraph_id": 74,
      "start": 319.05,
      "end": 328.95,
      "duration": 9.9,
      "text_snippet": "Java sử dụng phép toán bù 2 (two's complement). Việc cộng thêm 1 vào giá trị lớn"
    },
