    {
      "paragraph_id": 42,
      "start": 164.38,
      "end": 167.05,
      "duration": 2.67,
      "text_snippet": "Các giá trị mặc định phổ biến:"
    },
    {
      "paragraph_id": 43,
      "start": 167.05,
      "end": 170.49,
      "duration": 3.44,
      "text_snippet": "Các Sai Lầm Thường Gặp (Common Mistakes)"
