      "paragraph_id": 64,
      "start": 271.28,
      "end": 274.08,
      "duration": 2.8,
      "text_snippet": "Sử dụng float không có hậu tố F."
    },
    {
      "paragraph_id": 65,
      "start": 274.07,
      "end": 278.62,
      "duration": 4.55,
      "text_snippet": "Sử dụng long không có hậu tố L cho các hằng số lớn."
    },
    {
      "paragraph_id": 66,
      "start": 278.62,
      "end": 281.07,
      "duration": 2.45,
      "text_snippet": "Sử dụng dấu nháy kép cho char."
    },
    {
      "paragraph_id": 67,
      "start": 281.07,
      "end": 283.87,
      "duration": 2.8,
      "text_snippet": "Giả định rằng Java coi 1 là true."
