      "start": 313.84,
      "end": 316.22,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 73,
      "start": 316.21,
      "end": 319.05,
      "duration": 2.84,
      "text_snippet": "Tại Sao Lại Xảy Ra Hiện Tượng Này"
