    {
      "paragraph_id": 40,
      "start": 152.88,
      "end": 160.98,
      "duration": 8.1,
      "text_snippet": "Biến cục bộ (local variable) không tự động nhận giá trị mặc định. Chúng phải đượ"
    },
    {
      "paragraph_id": 41,
      "start": 161.07,
