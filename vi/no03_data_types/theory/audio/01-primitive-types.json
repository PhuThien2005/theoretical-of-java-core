    {
      "paragraph_id": 48,
      "start": 183.34,
      "end": 188.03,
      "duration": 4.69,
      "text_snippet": "Sử dụng các kiểu số thực dấu phẩy động cho các tính toán tiền tệ chính xác."
    },
    {
      "paragraph_id": 49,
      "start": 188.12,
