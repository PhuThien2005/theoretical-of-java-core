    },
    {
      "paragraph_id": 8,
      "start": 28.22,
      "end": 31.85,
      "duration": 3.63,
      "text_snippet": "Dấu gạch dưới có thể được dùng để tăng tính dễ đọc:"
    },
    {
      "paragraph_id": 9,
      "start": 31.85,
      "end": 34.23,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 10,
      "start": 34.22,
      "end": 38.29,
      "duration": 4.07,
