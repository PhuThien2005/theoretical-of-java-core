    },
    {
      "paragraph_id": 19,
      "start": 30.91,
      "end": 32.39,
      "duration": 1.48,
      "text_snippet": "Ép Kiểu Nới Rộng (Widening Casting)"
    },
    {
      "paragraph_id": 20,
      "start": 32.39,
      "end": 37.58,
      "duration": 5.19,
      "text_snippet": "Ép kiểu nới rộng (widening casting) nghĩa là chuyển đổi một kiểu dữ liệu nhỏ hơn sang một kiểu dữ liệu tương thích lớn h"
    },
    {
      "paragraph_id": 21,
      "start": 37.58,
      "end": 37.83,
      "duration": 0.25,
      "text_snippet": "Ví dụ:"
    },
    {
      "paragraph_id": 22,
      "start": 37.83,
      "end": 38.55,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 23,
      "start": 38.55,
      "end": 40.87,
      "duration": 2.32,
      "text_snippet": "Quá trình này thường an toàn và có thể diễn ra tự động."
    },
    {
      "paragraph_id": 24,
      "start": 40.87,
      "end": 41.59,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 25,
      "start": 41.59,
      "end": 47.21,
      "duration": 5.62,
      "text_snippet": "Lưu ý: biểu đồ này là một mô hình học tập được đơn giản hóa. Việc chuyển đổi số học có các chi tiết sẽ trở nên quan trọn"
    },
    {
      "paragraph_id": 26,
      "start": 47.21,
      "end": 48.69,
      "duration": 1.48,
      "text_snippet": "Ép Kiểu Thu Hẹp (Narrowing Casting)"
    },
    {
      "paragraph_id": 27,
      "start": 48.69,
      "end": 53.37,
      "duration": 4.69,
      "text_snippet": "Ép kiểu thu hẹp (narrowing casting) nghĩa là chuyển đổi một kiểu dữ liệu lớn hơn sang một kiểu dữ liệu nhỏ hơn."
    },
    {
      "paragraph_id": 28,
      "start": 53.37,
      "end": 53.63,
      "duration": 0.25,
      "text_snippet": "Ví dụ:"
    },
    {
      "paragraph_id": 29,
      "start": 53.63,
      "end": 54.34,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 30,
      "start": 54.34,
      "end": 57.38,
      "duration": 3.04,
      "text_snippet": "Ép kiểu thu hẹp cần phải ép kiểu tường minh và có thể làm mất thông tin."
    },
    {
      "paragraph_id": 31,
      "start": 57.38,
      "end": 58.02,
      "duration": 0.63,
      "text_snippet": "Một ví dụ khác:"
    },
    {
      "paragraph_id": 32,
      "start": 58.02,
      "end": 58.74,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 33,
      "start": 58.74,
      "end": 62.75,
      "duration": 4.01,
      "text_snippet": "Kết quả in ra là −126 thay vì 130 bởi vì kiểu byte chỉ có thể chứa các giá trị từ −128 đến 127."
    },
    {
      "paragraph_id": 34,
      "start": 62.75,
      "end": 64.69,
      "duration": 1.94,
      "text_snippet": "Tại Sao Ép Kiểu Thu Hẹp Có Thể Làm Mất Dữ Liệu"
    },
    {
      "paragraph_id": 35,
      "start": 64.69,
      "end": 65.96,
      "duration": 1.27,
      "text_snippet": "Phép Tương Tự: Xô Lớn → Xô Nhỏ"
    },
    {
      "paragraph_id": 36,
      "start": 65.96,
      "end": 83.18,
      "duration": 17.23,
      "text_snippet": "Hãy tưởng tượng kiểu int giống như một chiếc xô lớn 32-bit và kiểu byte là một chiếc xô nhỏ 8-bit. Nếu chiếc xô lớn chỉ "
    },
    {
      "paragraph_id": 37,
      "start": 83.18,
      "end": 85.8,
      "duration": 2.62,
      "text_snippet": "Cơ Chế Nhị Phân: Giữ Các Bit Thấp Nhất, Cắt Bỏ Các Bit Còn Lại"
    },
    {
      "paragraph_id": 38,
      "start": 85.8,
      "end": 95.22,
      "duration": 9.42,
      "text_snippet": "Khi Java thực hiện ép kiểu thu hẹp một giá trị, nó không thu tỷ lệ hoặc làm tròn số. Thay vào đó, nó thực hiện một thao "
    },
    {
      "paragraph_id": 39,
      "start": 95.22,
      "end": 98.85,
      "duration": 3.63,
      "text_snippet": "Đối với chuyển đổi int → byte, Java giữ lại 8 bit thấp nhất và loại bỏ 24 bit cao hơn."
    },
    {
      "paragraph_id": 40,
      "start": 98.85,
      "end": 100.03,
      "duration": 1.18,
      "text_snippet": "Ví Dụ Thực Tế 1: (byte) 1000"
    },
    {
      "paragraph_id": 41,
      "start": 100.03,
      "end": 101.89,
      "duration": 1.86,
      "text_snippet": "int value = 1000; ở dạng nhị phân (32 bits):"
    },
    {
      "paragraph_id": 42,
      "start": 101.89,
      "end": 102.61,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 43,
      "start": 102.61,
      "end": 104.42,
      "duration": 1.82,
      "text_snippet": "Java chỉ giữ lại 8 bit cuối cùng: 11101000."
    },
    {
      "paragraph_id": 44,
      "start": 104.42,
      "end": 109.45,
      "duration": 5.02,
      "text_snippet": "Trong biểu diễn số bù hai (two's complement), bit dẫn đầu 1 đại diện cho số âm. Giá trị của 11101000 được tính như sau:"
    },
    {
      "paragraph_id": 45,
      "start": 109.45,
      "end": 110.17,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 46,
      "start": 110.17,
      "end": 112.83,
      "duration": 2.66,
      "text_snippet": "Vì vậy, (byte) 1000 cho ra kết quả là −24, chứ không phải 1000!"
    },
    {
      "paragraph_id": 47,
      "start": 112.83,
      "end": 113.97,
      "duration": 1.14,
      "text_snippet": "Ví Dụ Thực Tế 2: (byte) 130"
    },
    {
      "paragraph_id": 48,
      "start": 113.97,
      "end": 115.78,
      "duration": 1.82,
      "text_snippet": "int value = 130; ở dạng nhị phân (32 bits):"
    },
    {
      "paragraph_id": 49,
      "start": 115.78,
      "end": 116.5,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 50,
      "start": 116.5,
      "end": 118.91,
      "duration": 2.41,
      "text_snippet": "Các bit được giữ lại: 10000010. Bit dẫn đầu là 1 → số âm."
    },
    {
      "paragraph_id": 51,
      "start": 118.91,
      "end": 119.62,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 52,
      "start": 119.62,
      "end": 120.72,
      "duration": 1.1,
      "text_snippet": "Mã Code Kèm Kết Quả Đầu Ra"
    },
    {
      "paragraph_id": 53,
      "start": 120.72,
      "end": 121.44,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 54,
      "start": 121.44,
      "end": 124.23,
      "duration": 2.79,
      "text_snippet": "int v2 = 130;\nbyte b2 = (byte) v2;\nSystem.out.println(b2); // -126"
    },
    {
      "paragraph_id": 55,
      "start": 124.23,
      "end": 128.24,
      "duration": 4.01,
      "text_snippet": "int v3 = 10;\nbyte b3 = (byte) v3;\nSystem.out.println(b3); // 10 — vừa khít, không mất dữ liệu\n`"
    },
    {
      "paragraph_id": 56,
      "start": 128.24,
      "end": 130.27,
      "duration": 2.03,
      "text_snippet": "Chuỗi Nguyên Nhân - Kết Quả (Cause-Effect Chain)"
    },
    {
      "paragraph_id": 57,
      "start": 130.27,
      "end": 140.06,
      "duration": 9.8,
      "text_snippet": "Kiểu dữ liệu lớn có nhiều bit hơn → ép kiểu sang kiểu dữ liệu nhỏ hơn → các bit cao dư thừa bị cắt bỏ → các bit còn lại "
    },
    {
      "paragraph_id": 58,
      "start": 140.06,
      "end": 140.99,
      "duration": 0.93,
      "text_snippet": "Hình Ảnh Trực Quan Hóa"
    },
    {
      "paragraph_id": 59,
      "start": 140.99,
      "end": 141.71,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 60,
      "start": 141.71,
      "end": 150.37,
      "duration": 8.66,
      "text_snippet": "> Cảnh báo: Ép kiểu thu hẹp từ double sang int có một hành vi bổ sung — Java sẽ loại bỏ phần thập phân (làm tròn về phía"
    },
    {
      "paragraph_id": 61,
      "start": 150.37,
      "end": 153.03,
      "duration": 2.66,
      "text_snippet": "> Xem thêm: Phần Ép Kiểu Thu Hẹp ở trên để biết cú pháp cơ bản."
    },
    {
      "paragraph_id": 62,
      "start": 153.03,
      "end": 154.63,
      "duration": 1.6,
      "text_snippet": "Phép Chia Số Nguyên (Integer Division)"
    },
    {
      "paragraph_id": 63,
      "start": 154.63,
      "end": 158.56,
      "duration": 3.93,
      "text_snippet": "Khi cả hai toán hạng đều là số nguyên, Java thực hiện phép chia số nguyên (integer division)."
    },
    {
      "paragraph_id": 64,
      "start": 158.56,
      "end": 159.27,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 65,
      "start": 159.27,
      "end": 162.69,
      "duration": 3.42,
      "text_snippet": "Nếu ít nhất một toán hạng là kiểu số thực, kết quả có thể bao gồm phần thập phân."
    },
    {
      "paragraph_id": 66,
      "start": 162.69,
      "end": 163.41,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 67,
      "start": 163.41,
      "end": 165.27,
      "duration": 1.86,
      "text_snippet": "Tự Động Nâng Kiểu Số Học (Numeric Promotion)"
    },
    {
      "paragraph_id": 68,
      "start": 165.27,
      "end": 168.86,
      "duration": 3.59,
      "text_snippet": "Java có thể tự động nâng các kiểu số nhỏ hơn trong quá trình thực hiện các phép toán."
    },
    {
      "paragraph_id": 69,
      "start": 168.86,
      "end": 169.11,
      "duration": 0.25,
      "text_snippet": "Ví dụ:"
    },
    {
      "paragraph_id": 70,
      "start": 169.11,
      "end": 169.83,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 71,
      "start": 169.83,
      "end": 176.12,
      "duration": 6.29,
      "text_snippet": "Phép toán a + b được nâng kiểu lên thành int, vì vậy việc lưu trữ trực tiếp kết quả vào kiểu byte là không được phép nếu"
    },
    {
      "paragraph_id": 72,
      "start": 176.12,
      "end": 176.71,
      "duration": 0.59,
      "text_snippet": "Lỗi Thường Gặp"
    },
    {
      "paragraph_id": 73,
      "start": 176.71,
      "end": 187.61,
      "duration": 10.89,
      "text_snippet": "Kỳ vọng 5 / 2 sẽ tạo ra kết quả 2.5.\nQuên thêm chữ L cho các giá trị trực tiếp kiểu long lớn.\nQuên thêm chữ F cho các gi"
    }
  ]
}