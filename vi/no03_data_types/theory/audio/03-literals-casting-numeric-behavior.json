      "duration": 3.67,
      "text_snippet": "Giá Trị Trực Tiếp, Ép Kiểu, Và Hành Vi Số Học (Literals, Casting, and Numeric Behavior)"
    },
    {
      "paragraph_id": 2,
      "start": 3.67,
      "end": 7.14,
      "duration": 3.46,
      "text_snippet": "Một giá trị trực tiếp (literal) là một giá trị được viết trực tiếp trong mã nguồn."
    },
    {
      "paragraph_id": 3,
      "start": 7.14,
      "end": 7.39,
      "duration": 0.25,
      "text_snippet": "Ví dụ:"
    },
