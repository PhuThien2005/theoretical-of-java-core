      "text_snippet": "Ví dụ:"
    },
    {
      "paragraph_id": 22,
      "start": 76.59,
      "end": 78.97,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 23,
      "start": 78.96,
      "end": 82.77,
      "duration": 3.81,
      "text_snippet": "Quá trình này thường an toàn và có thể diễn ra tự động."
    },
    {
      "paragraph_id": 24,
      "start": 82.78,
      "end": 85.16,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 25,
      "start": 85.15,
      "end": 94.09,
      "duration": 8.94,
      "text_snippet": "Lưu ý: biểu đồ này là một mô hình học tập được đơn giản hóa. Việc chuyển đổi số "
    },
    {
      "paragraph_id": 26,
      "start": 94.19,
      "end": 104.59,
      "duration": 10.4,
      "text_snippet": "Ép Kiểu Thu Hẹp (Narrowing Casting)"
    },
    {
      "paragraph_id": 27,
      "start": 104.59,
      "end": 112.64,
      "duration": 8.05,
      "text_snippet": "Ép kiểu thu hẹp (narrowing casting) nghĩa là chuyển đổi một kiểu dữ liệu lớn hơn"
    },
    {
      "paragraph_id": 28,
      "start": 104.59,
      "end": 106.19,
      "duration": 1.6,
      "text_snippet": "Ví dụ:"
    },
    {
      "paragraph_id": 29,
      "start": 106.19,
      "end": 108.57,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 30,
      "start": 108.56,
      "end": 113.12,
      "duration": 4.56,
      "text_snippet": "Ép kiểu thu hẹp cần phải ép kiểu tường minh và có thể làm mất thông tin."
    },
    {
      "paragraph_id": 31,
      "start": 113.12,
      "end": 114.52,
      "duration": 1.4,
      "text_snippet": "Một ví dụ khác:"
    },
    {
      "paragraph_id": 32,
      "start": 114.53,
      "end": 115.93,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 33,
      "start": 115.92,
      "end": 124.32,
      "duration": 8.4,
      "text_snippet": "Kết quả in ra là −126 thay vì 130 bởi vì kiểu byte chỉ có thể chứa các giá trị t"
    },
    {
      "paragraph_id": 34,
      "start": 124.33,
      "end": 128.53,
      "duration": 4.2,
      "text_snippet": "Tại Sao Ép Kiểu Thu Hẹp Có Thể Làm Mất Dữ Liệu"
    },
    {
      "paragraph_id": 35,
      "start": 128.53,
      "end": 131.33,
      "duration": 2.8,
      "text_snippet": "Phép Tương Tự: Xô Lớn → Xô Nhỏ"
    },
    {
      "paragraph_id": 36,
      "start": 131.32,
      "end": 164.22,
      "duration": 32.9,
      "text_snippet": "Hãy tưởng tượng kiểu int giống như một chiếc xô lớn 32-bit và kiểu byte là một c"
    },
    {
      "paragraph_id": 37,
      "start": 164.22,
      "end": 169.47,
      "duration": 5.25,
      "text_snippet": "Cơ Chế Nhị Phân: Giữ Các Bit Thấp Nhất, Cắt Bỏ Các Bit Còn Lại"
    },
    {
      "paragraph_id": 38,
      "start": 169.47,
      "end": 188.02,
      "duration": 18.55,
      "text_snippet": "Khi Java thực hiện ép kiểu thu hẹp một giá trị, nó không thu tỷ lệ hoặc làm tròn"
    },
    {
      "paragraph_id": 39,
      "start": 188.02,
      "end": 195.37,
      "duration": 7.35,
      "text_snippet": "Đối với chuyển đổi int → byte, Java giữ lại 8 bit thấp nhất và loại bỏ 24 bit ca"
    },
    {
      "paragraph_id": 40,
      "start": 195.38,
      "end": 197.83,
      "duration": 2.45,
      "text_snippet": "Ví Dụ Thực Tế 1: (byte) 1000"
    },
    {
      "paragraph_id": 41,
      "start": 197.82,
      "end": 201.32,
      "duration": 3.5,
      "text_snippet": "int value = 1000; ở dạng nhị phân (32 bits):"
    },
    {
      "paragraph_id": 42,
      "start": 201.32,
      "end": 202.72,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 43,
      "start": 202.72,
      "end": 205.87,
      "duration": 3.15,
      "text_snippet": "Java chỉ giữ lại 8 bit cuối cùng: 11101000."
    },
    {
      "paragraph_id": 44,
      "start": 205.88,
      "end": 214.63,
      "duration": 8.75,
      "text_snippet": "Trong biểu diễn số bù hai (two's complement), bit dẫn đầu 1 đại diện cho số âm. "
    },
    {
      "paragraph_id": 45,
      "start": 214.62,
      "end": 216.02,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 46,
      "start": 216.12,
      "end": 222.0,
      "duration": 5.88,
      "text_snippet": "Vì vậy, (byte) 1000 cho ra kết quả là −24, chứ không phải 1000!"
    },
    {
      "paragraph_id": 47,
      "start": 221.95,
      "end": 225.9,
      "duration": 3.95,
      "text_snippet": "Ví Dụ Thực Tế 2: (byte) 130"
    },
    {
      "paragraph_id": 48,
      "start": 225.9,
      "end": 230.52,
      "duration": 4.62,
      "text_snippet": "int value = 130; ở dạng nhị phân (32 bits):"
    },
    {
      "paragraph_id": 49,
      "start": 230.52,
      "end": 232.9,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 50,
      "start": 232.9,
      "end": 239.44,
      "duration": 6.54,
      "text_snippet": "Các bit được giữ lại: 10000010. Bit dẫn đầu là 1 → số âm."
    },
    {
      "paragraph_id": 51,
      "start": 239.54,
      "end": 241.92,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 52,
      "start": 241.86,
      "end": 244.47,
      "duration": 2.61,
      "text_snippet": "Mã Code Kèm Kết Quả Đầu Ra"
    },
    {
      "paragraph_id": 53,
      "start": 244.47,
      "end": 246.85,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 54,
      "start": 246.85,
      "end": 250.75,
      "duration": 3.9,
      "text_snippet": "Chuỗi Nguyên Nhân - Kết Quả (Cause-Effect Chain)"
    },
    {
      "paragraph_id": 55,
      "start": 250.75,
      "end": 264.66,
      "duration": 13.91,
      "text_snippet": "Kiểu dữ liệu lớn có nhiều bit hơn → ép kiểu sang kiểu dữ liệu nhỏ hơn → các bit "
    },
    {
      "paragraph_id": 56,
      "start": 264.76,
      "end": 266.95,
      "duration": 2.19,
      "text_snippet": "Hình Ảnh Trực Quan Hóa"
    },
    {
      "paragraph_id": 57,
      "start": 266.9,
      "end": 269.28,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 58,
      "start": 269.27,
      "end": 284.43,
      "duration": 15.16,
      "text_snippet": "Cảnh báo: Ép kiểu thu hẹp từ double sang int có một hành vi bổ sung — Java sẽ lo"
    },
    {
      "paragraph_id": 59,
      "start": 284.44,
      "end": 288.84,
      "duration": 4.4,
      "text_snippet": "Xem thêm: Phần Ép Kiểu Thu Hẹp ở trên để biết cú pháp cơ bản."
    },
    {
      "paragraph_id": 60,
      "start": 288.84,
      "end": 292.24,
      "duration": 3.4,
      "text_snippet": "Phép Chia Số Nguyên (Integer Division)"
    },
    {
      "paragraph_id": 61,
      "start": 292.24,
      "end": 298.54,
      "duration": 6.3,
      "text_snippet": "Khi cả hai toán hạng đều là số nguyên, Java thực hiện phép chia số nguyên (integ"
    },
    {
      "paragraph_id": 62,
      "start": 298.54,
      "end": 299.94,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 63,
      "start": 299.94,
      "end": 306.59,
      "duration": 6.65,
      "text_snippet": "Nếu ít nhất một toán hạng là kiểu số thực, kết quả có thể bao gồm phần thập phân"
    },
    {
      "paragraph_id": 64,
      "start": 306.59,
      "end": 307.99,
      "duration": 1.4,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 65,
      "start": 307.99,
      "end": 310.79,
      "duration": 2.8,
      "text_snippet": "Tự Động Nâng Kiểu Số Học (Numeric Promotion)"
    },
    {
      "paragraph_id": 66,
      "start": 310.89,
      "end": 316.03,
      "duration": 5.14,
      "text_snippet": "Java có thể tự động nâng các kiểu số nhỏ hơn trong quá trình thực hiện các phép "
    },
    {
      "paragraph_id": 67,
      "start": 315.97,
      "end": 317.57,
      "duration": 1.6,
      "text_snippet": "Ví dụ:"
    },
    {
      "paragraph_id": 68,
      "start": 317.57,
      "end": 319.95,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 69,
      "start": 319.95,
      "end": 328.12,
      "duration": 8.17,
      "text_snippet": "Phép toán a + b được nâng kiểu lên thành int, vì vậy việc lưu trữ trực tiếp kết "
    },
    {
      "paragraph_id": 70,
      "start": 328.12,
      "end": 329.76,
      "duration": 1.64,
      "text_snippet": "Lỗi Thường Gặp"
    },
    {
      "paragraph_id": 71,
      "start": 329.76,
      "end": 333.61,
      "duration": 3.85,
      "text_snippet": "Kỳ vọng 5 / 2 sẽ tạo ra kết quả 2.5."
    },
    {
      "paragraph_id": 72,
      "start": 333.61,
      "end": 338.16,
      "duration": 4.55,
      "text_snippet": "Quên thêm chữ L cho các giá trị trực tiếp kiểu long lớn."
    },
    {
      "paragraph_id": 73,
      "start": 338.16,
      "end": 342.36,
      "duration": 4.2,
      "text_snippet": "Quên thêm chữ F cho các giá trị trực tiếp kiểu float."
    },
    {
      "paragraph_id": 74,
      "start": 342.36,
      "end": 345.86,
      "duration": 3.5,
      "text_snippet": "Giả định rằng ép kiểu thu hẹp luôn an toàn."
    },
    {
      "paragraph_id": 75,
      "start": 345.86,
      "end": 351.11,
      "duration": 5.25,
      "text_snippet": "Bỏ qua việc tự động nâng kiểu số học trong các biểu thức toán học."
    }
  ]
