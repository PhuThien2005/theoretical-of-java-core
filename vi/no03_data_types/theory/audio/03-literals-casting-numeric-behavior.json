      "end": 83.69,
      "duration": 8.75,
      "text_snippet": "Ép kiểu nới rộng (widening casting) nghĩa là chuyển đổi một kiểu dữ liệu nhỏ hơn"
    },
    {
      "paragraph_id": 21,
      "start": 75.04,
      "end": 76.64,
