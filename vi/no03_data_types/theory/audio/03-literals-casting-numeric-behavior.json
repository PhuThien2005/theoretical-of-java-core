      "start": 26.77,
      "end": 28.08,
      "duration": 1.31,
      "text_snippet": "Kiểu char sử dụng dấu nháy đơn:"
    },
    {
      "paragraph_id": 16,
      "start": 28.08,
      "end": 28.8,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 17,
      "start": 28.8,
      "end": 30.19,
      "duration": 1.39,
      "text_snippet": "Kiểu String sử dụng dấu nháy kép:"
    },
    {
      "paragraph_id": 18,
