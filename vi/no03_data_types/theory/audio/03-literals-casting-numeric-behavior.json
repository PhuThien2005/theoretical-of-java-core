      "start": 7.39,
      "end": 8.11,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 5,
      "start": 8.11,
      "end": 10.05,
      "duration": 1.94,
      "text_snippet": "Giá Trị Trực Tiếp Số Nguyên (Integer Literals)"
    },
    {
      "paragraph_id": 6,
      "start": 10.05,
      "end": 13.05,
      "duration": 3.0,
      "text_snippet": "int là kiểu mặc định của giá trị trực tiếp số nguyên (integer literal)."
    },
    {
      "paragraph_id": 7,
      "start": 13.05,
      "end": 13.77,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 8,
      "start": 13.77,
      "end": 15.92,
      "duration": 2.15,
      "text_snippet": "Dấu gạch dưới có thể được dùng để tăng tính dễ đọc:"
    },
    {
      "paragraph_id": 9,
      "start": 15.92,
      "end": 16.64,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 10,
      "start": 16.64,
      "end": 18.79,
      "duration": 2.15,
      "text_snippet": "Giá Trị Trực Tiếp Số Thực (Floating-Point Literals)"
    },
    {
      "paragraph_id": 11,
      "start": 18.79,
      "end": 21.28,
      "duration": 2.49,
      "text_snippet": "double là kiểu mặc định của giá trị trực tiếp số thập phân."
    },
    {
      "paragraph_id": 12,
      "start": 21.28,
      "end": 22.0,
      "duration": 0.72,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 13,
      "start": 22.0,
      "end": 24.28,
      "duration": 2.28,
      "text_snippet": "Nếu không có ký tự F, 0.5 sẽ được hiểu là kiểu double."
    },
    {
      "paragraph_id": 14,
      "start": 24.28,
      "end": 26.77,
      "duration": 2.49,
      "text_snippet": "Giá Trị Trực Tiếp char và String (String and char Literals)"
    },
    {
