    {
      "paragraph_id": 18,
      "start": 92.15,
      "end": 97.98,
      "duration": 5.83,
      "text_snippet": "Giữ và Đợi (Hold and Wait): Các luồng đang nắm giữ khóa sẽ đợi để có thêm các kh"
    },
    {
      "paragraph_id": 19,
      "start": 97.97,
      "end": 103.8,
      "duration": 5.83,
      "text_snippet": "Không cướp đoạt (No Preemption): Các khóa không thể bị tước đoạt một cách ép buộ"
    },
    {
      "paragraph_id": 20,
      "start": 103.8,
      "end": 111.0,
      "duration": 7.2,
      "text_snippet": "Chờ đợi vòng lặp (Circular Wait): Luồng A giữ Khóa 1 và chờ Khóa 2; Luồng B giữ "
    },
