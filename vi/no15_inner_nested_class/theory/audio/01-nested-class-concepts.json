      "paragraph_id": 93,
      "start": 746.07,
      "end": 749.92,
      "duration": 3.85,
      "text_snippet": "1. Khởi tạo trực tiếp lớp nội bộ không qua thực thể ngoài"
    },
    {
      "paragraph_id": 94,
      "start": 749.87,
      "end": 755.93,
      "duration": 6.06,
      "text_snippet": "Một lỗi phổ biến là cố gắng khởi tạo một lớp nội bộ phi tĩnh như thể nó là một l"
    },
    {
      "paragraph_id": 95,
      "start": 755.94,
      "end": 758.32,
      "duration": 2.38,
      "text_snippet": "Đoạn mã mẫu Java:"
    },
    {
      "paragraph_id": 96,
      "start": 758.31,
      "end": 762.4,
      "duration": 4.09,
      "text_snippet": "2. Truy cập các thành viên thực thể từ lớp lồng nhau tĩnh"
    },
    {
      "paragraph_id": 97,
      "start": 762.5,
      "end": 769.21,
      "duration": 6.71,
      "text_snippet": "Các lớp lồng nhau tĩnh không thể truy cập trực tiếp các trường phi tĩnh bên ngoà"
