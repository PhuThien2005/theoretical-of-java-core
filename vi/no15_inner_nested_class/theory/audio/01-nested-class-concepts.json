      "paragraph_id": 91,
      "start": 734.89,
      "end": 745.98,
      "duration": 11.09,
      "text_snippet": "Quản lý không gian tên (Namespace Management): Ngăn chặn việc làm lộn xộn không "
    },
    {
      "paragraph_id": 92,
      "start": 745.97,
      "end": 747.37,
      "duration": 1.4,
      "text_snippet": "Các lỗi thường gặp"
    },
