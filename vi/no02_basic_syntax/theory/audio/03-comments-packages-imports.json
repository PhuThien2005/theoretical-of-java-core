      "paragraph_id": 59,
      "start": 302.54,
      "end": 307.7,
      "duration": 5.16,
      "text_snippet": "Nghĩ rằng import java.util.* cũng import gói con."
    },
    {
      "paragraph_id": 60,
      "start": 307.7,
      "end": 310.44,
      "duration": 2.74,
      "text_snippet": "Viết chú thích lặp lại code hiển nhiên."
